
# =====================================================
# E-COMMERCE DATA ANALYTICS PROJECT
# DATA PREPARATION AND RFM CUSTOMER SEGMENTATION
# =====================================================

import pandas as pd
import numpy as np


# 1. LOAD CLEANED DATA

df = pd.read_csv('RetailCleaned.csv', header=None)

df.columns = [
    'Invoice',
    'StockCode',
    'Description',
    'Quantity',
    'InvoiceDate',
    'Price',
    'Customer_ID',
    'Country',
    'SourceSheet'
]

df['InvoiceDate'] = pd.to_datetime(df['InvoiceDate'])

print("Dataset Shape:", df.shape)
df.info()


# 2. FILTER DATA FOR RFM ANALYSIS

rfm_data = df[
    (df['Customer_ID'].notna()) &
    (df['Quantity'] > 0)
].copy()


# 3. CALCULATE RECENCY, FREQUENCY AND MONETARY

snapshot_date = pd.to_datetime('2011-12-10')

rfm = rfm_data.groupby('Customer_ID').agg(

    Recency=('InvoiceDate',
             lambda x: (snapshot_date - x.max()).days),

    Frequency=('Invoice', 'nunique'),

    Monetary=('Invoice',
              lambda x: (
                  rfm_data.loc[x.index, 'Quantity'] *
                  rfm_data.loc[x.index, 'Price']
              ).sum())

).reset_index()


# 4. CALCULATE RFM SCORES

rfm['R_Score'] = pd.qcut(
    rfm['Recency'],
    5,
    labels=[5, 4, 3, 2, 1]
).astype(int)

rfm['F_Score'] = pd.qcut(
    rfm['Frequency'].rank(method='first'),
    5,
    labels=[1, 2, 3, 4, 5]
).astype(int)

rfm['M_Score'] = pd.qcut(
    rfm['Monetary'],
    5,
    labels=[1, 2, 3, 4, 5]
).astype(int)


# 5. ASSIGN CUSTOMER SEGMENTS

def segment_customer(row):

    if row['R_Score'] >= 4 and row['F_Score'] >= 4 and row['M_Score'] >= 4:
        return 'Champions'

    elif row['R_Score'] >= 3 and row['F_Score'] >= 3:
        return 'Loyal'

    elif row['R_Score'] <= 2 and row['F_Score'] >= 3:
        return 'At Risk'

    elif row['R_Score'] >= 4 and row['F_Score'] <= 2:
        return 'New'

    elif row['R_Score'] == 3 and row['F_Score'] <= 2:
        return 'Needs Attention'

    else:
        return 'Lost'


rfm['Segment'] = rfm.apply(segment_customer, axis=1)


# 6. IDENTIFY CHURNED CUSTOMERS

rfm['IsChurned'] = rfm['Recency'] > 90


# 7. PREPARE TRANSACTION DATA

df = df[
    (df['Customer_ID'].notna()) &
    (df['Quantity'] > 0)
].copy()

df['InvoiceMonth'] = (
    df['InvoiceDate'].dt.to_period('M').dt.to_timestamp()
)

df['Revenue'] = df['Quantity'] * df['Price']


# 8. MERGE RFM RESULTS WITH TRANSACTION DATA

df_final = df.merge(
    rfm[
        [
            'Customer_ID',
            'Recency',
            'Frequency',
            'Monetary',
            'R_Score',
            'F_Score',
            'M_Score',
            'Segment',
            'IsChurned'
        ]
    ],
    on='Customer_ID',
    how='left'
)


# 9. VALIDATE FINAL DATASET

print("\nFinal Dataset Shape:", df_final.shape)

print("\nMissing Values:")
print(df_final.isnull().sum())

print("\nCustomer Segment Distribution:")
print(df_final['Segment'].value_counts())

print("\nChurn Distribution:")
print(df_final['IsChurned'].value_counts())


# 10. EXPORT FINAL DATASET

df_final.to_excel(
    'EcommerceDashboardData.xlsx',
    index=False
)

print("\nFinal dataset exported successfully!")
